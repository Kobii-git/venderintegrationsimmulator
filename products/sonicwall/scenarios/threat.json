{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "SonicWall",
      "product": "SonicOS",
      "version": "SonicOS 7",
      "family": "threat",
      "name": "Threat",
      "signature": "1001",
      "severity": 5,
      "default_format": "native",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": "{{ spt }}",
      "dpt": "{{ dpt }}",
      "action": "blocked"
    },
    "record": {
      "TimeGenerated": "{{ generated_at_iso }}",
      "Computer": "{{ hostname }}",
      "SourceIP": "{{ src }}",
      "DestinationIP": "{{ dst }}",
      "UserName": "{{ user }}",
      "EventFamily": "threat",
      "CorrelationId": "{{ correlation_id }}"
    },
    "native": "id=firewall sn=LAB000001 time=\"{{ generated_at_iso }}\" fw={{ device_ip }} pri=6 c=16 m=609 msg=\"Gateway Anti-Virus Alert: EICAR\" src={{ src }}:{{ spt }}:X0 dst={{ dst }}:{{ dpt }}:X1 proto=tcp/https user=\"{{ user }}\""
  }
}
