{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Trend Micro",
      "product": "Deep Security Agent",
      "version": "Deep Security 20 CEF",
      "family": "integrity-monitoring",
      "name": "Integrity Monitoring",
      "signature": "2002779",
      "severity": 5,
      "default_format": "cef",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": "{{ spt }}",
      "dpt": "{{ dpt }}",
      "action": "allowed",
      "cef_extensions": {
        "cn1": "1",
        "cn1Label": "Host ID",
        "filePath": "/etc/passwd",
        "act": "updated"
      }
    },
    "record": {
      "TimeGenerated": "{{ generated_at_iso }}",
      "Computer": "{{ hostname }}",
      "SourceIP": "{{ src }}",
      "DestinationIP": "{{ dst }}",
      "UserName": "{{ user }}",
      "EventFamily": "integrity-monitoring",
      "CorrelationId": "{{ correlation_id }}"
    }
  }
}
