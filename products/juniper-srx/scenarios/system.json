{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Juniper",
      "product": "SRX",
      "version": "Junos 23 structured syslog",
      "family": "system",
      "name": "System",
      "signature": "1004",
      "severity": 5,
      "default_format": "native",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": "{{ spt }}",
      "dpt": "{{ dpt }}",
      "action": "allowed"
    },
    "record": {
      "TimeGenerated": "{{ generated_at_iso }}",
      "Computer": "{{ hostname }}",
      "SourceIP": "{{ src }}",
      "DestinationIP": "{{ dst }}",
      "UserName": "{{ user }}",
      "EventFamily": "system",
      "CorrelationId": "{{ correlation_id }}"
    },
    "native": "mgd[1234]: UI_COMMIT_COMPLETED: commit complete by {{ user }}"
  }
}
