{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Sophos",
      "product": "XG Firewall",
      "version": "SFOS 19.5",
      "family": "vpn",
      "name": "Vpn",
      "signature": "1003",
      "severity": 5,
      "default_format": "native",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": "{{ spt }}",
      "dpt": "{{ dpt }}",
      "action": "allowed"
    },
    "record": {
      "TimeGenerated": "{{ generated_at_iso }}",
      "Computer": "{{ hostname }}",
      "SourceIP": "{{ src }}",
      "DestinationIP": "{{ dst }}",
      "UserName": "{{ user }}",
      "EventFamily": "vpn",
      "CorrelationId": "{{ correlation_id }}"
    },
    "native": "device_name=\"{{ hostname }}\" log_type=\"Event\" log_component=\"SSL VPN\" log_subtype=\"Authentication\" user_name=\"{{ user }}\" src_ip={{ src }} status=\"Success\""
  }
}
