      "DestinationIP": "{{ dst }}",
      "UserName": "{{ user }}",
      "EventFamily": "ips",
      "CorrelationId": "{{ correlation_id }}"
    },
    "native": "device_name=\"{{ hostname }}\" device_id=\"C01001LAB\" log_id=\"010101600001\" log_type=\"IPS\" log_component=\"Signatures\" log_subtype=\"Drop\" priority=\"Information\" src_ip={{ src }} dst_ip={{ dst }} src_port={{ spt }} dst_port={{ dpt }} protocol=\"TCP\" user_name=\"{{ user }}\" status=\"Allow\""
