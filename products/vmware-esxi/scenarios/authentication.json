{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "VMware",
      "product": "ESXi",
      "version": "ESXi 8",
      "family": "authentication",
      "name": "Authentication",
      "signature": "1000",
      "severity": 5,
      "default_format": "native",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": "{{ spt }}",
      "dpt": "{{ dpt }}",
      "action": "allowed"
    },
    "record": {
      "TimeGenerated": "{{ generated_at_iso }}",
      "Computer": "{{ hostname }}",
      "SourceIP": "{{ src }}",
      "DestinationIP": "{{ dst }}",
      "UserName": "{{ user }}",
      "EventFamily": "authentication",
      "CorrelationId": "{{ correlation_id }}"
    },
    "native": "Hostd: [Originator@6876 sub=Vimsvc.ha-eventmgr] Event 123 : User {{ user }}@{{ src }} logged in as VMware-client"
  }
