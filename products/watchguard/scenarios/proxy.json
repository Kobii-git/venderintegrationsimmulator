{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "WatchGuard",
      "product": "Firebox",
      "version": "Fireware 12",
      "family": "proxy",
      "name": "Proxy",
      "signature": "1002",
      "severity": 5,
      "default_format": "native",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": "{{ spt }}",
      "dpt": "{{ dpt }}",
      "action": "allowed"
    },
    "record": {
      "TimeGenerated": "{{ generated_at_iso }}",
      "Computer": "{{ hostname }}",
      "SourceIP": "{{ src }}",
      "DestinationIP": "{{ dst }}",
      "UserName": "{{ user }}",
      "EventFamily": "proxy",
      "CorrelationId": "{{ correlation_id }}"
    },
    "native": "{{ hostname }} Allow {{ src }} {{ dst }} https/tcp {{ spt }} {{ dpt }} Trusted External (LabPolicy) proc_id=\"firewall\" rc=\"100\" msg_id=\"3000-0148\" proxy_act=\"HTTP-Lab\" op=\"GET\" dstname=\"example.test\""
  }
