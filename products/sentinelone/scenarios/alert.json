{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "SentinelOne",
      "product": "Singularity",
      "version": "Management API v2.1",
      "family": "alert",
      "name": "Alert",
      "signature": "1001",
      "severity": 5,
      "default_format": "json",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": "{{ spt }}",
      "dpt": "{{ dpt }}",
      "action": "allowed"
    },
    "record": {
      "id": "{{ correlation_id }}",
      "createdAt": "{{ generated_at_iso }}",
      "activityType": 1,
      "primaryDescription": "alert",
      "agent": {
        "computerName": "{{ hostname }}",
        "networkInterfaces": [
          {
            "inet": [
              "{{ device_ip }}"
            ]
          }
        ]
      },
      "threatInfo": {
        "threatName": "EICAR test file",
        "classification": "Malware",
        "confidenceLevel": "malicious",
        "mitigationStatus": "not_mitigated"
      },
      "activityUuid": "{{ correlation_id }}"
    }
  }
}
