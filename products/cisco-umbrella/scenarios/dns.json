{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Cisco",
      "product": "Umbrella",
      "version": "Umbrella S3 log schema",
      "family": "dns",
      "name": "Dns",
      "signature": "1000",
      "severity": 5,
      "default_format": "csv",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": "{{ spt }}",
      "dpt": "{{ dpt }}",
      "action": "allowed"
    },
    "record": {
      "Timestamp": "{{ generated_at_iso }}",
      "Identity": "{{ user }}",
      "InternalIp": "{{ src }}",
      "ExternalIp": "{{ device_ip }}",
      "Action": "Blocked",
      "QueryType": "A",
      "ResponseCode": "NOERROR",
      "Domain": "example.test",
      "Categories": [
        "Malware"
      ],
      "LogType": "dns"
    },
    "csv": [
      "{{ generated_at_iso }}",
      "{{ user }}",
      "{{ user }}",
      "{{ src }}",
      "{{ device_ip }}",
      "Blocked",
      "A",
      "NOERROR",
      "example.test",
      "Malware",
      "DNS",
      "Identity",
      "",
      ""
    ]
  }
}
