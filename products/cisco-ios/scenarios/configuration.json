      "SourceIP": "{{ src }}",
      "DestinationIP": "{{ dst }}",
      "UserName": "{{ user }}",
      "EventFamily": "configuration",
      "CorrelationId": "{{ correlation_id }}"
    },
    "native": "%SYS-5-CONFIG_I: Configured from console by {{ user }} on vty0 ({{ src }})"
