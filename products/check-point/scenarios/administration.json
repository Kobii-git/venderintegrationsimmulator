{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Check Point",
      "product": "VPN-1 & FireWall-1",
      "version": "Log Exporter R81 CEF",
      "family": "administration",
      "name": "Administration",
      "signature": "administration",
      "severity": 5,
      "default_format": "cef",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": "{{ spt }}",
      "dpt": "{{ dpt }}",
      "action": "allowed",
      "cef_extensions": {
        "cs1": "LabPolicy",
        "cs1Label": "Rule Name",
        "deviceDirection": "0"
      }
    },
    "record": {
      "TimeGenerated": "{{ generated_at_iso }}",
      "Computer": "{{ hostname }}",
      "SourceIP": "{{ src }}",
      "DestinationIP": "{{ dst }}",
      "UserName": "{{ user }}",
      "EventFamily": "administration",
      "CorrelationId": "{{ correlation_id }}"
    }
  }
}
