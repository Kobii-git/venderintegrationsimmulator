{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Microsoft",
      "product": "Entra ID",
      "version": "SigninLogs / AuditLogs schema",
      "family": "directory-audit",
      "name": "Directory Audit",
      "signature": "1001",
      "severity": 5,
      "default_format": "json",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": "{{ spt }}",
      "dpt": "{{ dpt }}",
      "action": "allowed"
    },
    "record": {
      "TimeGenerated": "{{ generated_at_iso }}",
      "Id": "{{ correlation_id }}",
      "OperationName": "Add user",
      "Category": "UserManagement",
      "Result": "success",
      "InitiatedBy": {
        "user": {
          "userPrincipalName": "admin@example.test",
          "ipAddress": "{{ src }}"
        }
      },
      "TargetResources": [
        {
          "displayName": "{{ user }}",
          "type": "User"
        }
      ]
    }
  }
}
