{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Cisco",
      "product": "FTD",
      "version": "Secure Firewall 7.4",
      "family": "connection",
      "name": "Connection",
      "signature": "1000",
      "severity": 5,
      "default_format": "native",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": "{{ spt }}",
      "dpt": "{{ dpt }}",
      "action": "allowed"
    },
    "record": {
      "TimeGenerated": "{{ generated_at_iso }}",
      "Computer": "{{ hostname }}",
      "SourceIP": "{{ src }}",
      "DestinationIP": "{{ dst }}",
      "UserName": "{{ user }}",
      "EventFamily": "connection",
      "CorrelationId": "{{ correlation_id }}"
    },
    "native": "%FTD-6-302013: Built outbound TCP connection 1234 for outside:{{ dst }}/{{ dpt }} to inside:{{ src }}/{{ spt }}"
  }
}
