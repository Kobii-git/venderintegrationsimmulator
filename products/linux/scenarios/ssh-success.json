{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Linux",
      "product": "OpenSSH / sudo",
      "version": "OpenSSH 9 / sudo 1.9",
      "family": "ssh-success",
      "name": "Ssh Success",
      "signature": "1000",
      "severity": 5,
      "default_format": "native",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": "{{ spt }}",
      "dpt": "{{ dpt }}",
      "action": "allowed"
    },
    "record": {
      "TimeGenerated": "{{ generated_at_iso }}",
      "Computer": "{{ hostname }}",
      "SourceIP": "{{ src }}",
      "DestinationIP": "{{ dst }}",
      "UserName": "{{ user }}",
      "EventFamily": "ssh-success",
      "CorrelationId": "{{ correlation_id }}"
    },
    "native": "sshd[1234]: Accepted password for {{ user }} from {{ src }} port {{ spt }} ssh2"
  }
}
