{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Linux",
      "product": "OpenSSH / sudo",
      "version": "OpenSSH 9 / sudo 1.9",
      "family": "sudo",
      "name": "Sudo",
      "signature": "1002",
      "severity": 5,
      "default_format": "native",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": "{{ spt }}",
      "dpt": "{{ dpt }}",
      "action": "allowed"
    },
    "record": {
      "TimeGenerated": "{{ generated_at_iso }}",
      "Computer": "{{ hostname }}",
      "SourceIP": "{{ src }}",
      "DestinationIP": "{{ dst }}",
      "UserName": "{{ user }}",
      "EventFamily": "sudo",
      "CorrelationId": "{{ correlation_id }}"
    },
    "native": "sudo: {{ user }} : TTY=pts/0 ; PWD=/home/{{ user }} ; USER=root ; COMMAND=/usr/bin/id"
  }
}
