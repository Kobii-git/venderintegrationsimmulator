{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Microsoft",
      "product": "Sysmon",
      "version": "Sysmon 15 event schema",
      "family": "network-connect",
      "name": "Network Connect",
      "signature": "3",
      "severity": 5,
      "default_format": "xml",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": "{{ spt }}",
      "dpt": "{{ dpt }}",
      "action": "allowed"
    },
    "record": {
      "TimeGenerated": "{{ generated_at_iso }}",
      "Computer": "{{ hostname }}",
      "EventID": 3,
      "EventRecordId": "{{ event_sequence + 1 }}",
      "Channel": "Microsoft-Windows-Sysmon/Operational",
      "Provider": "Microsoft-Windows-Sysmon",
      "EventData": {
        "RuleName": "-",
        "UtcTime": "{{ generated_at_iso }}",
        "ProcessGuid": "{{ correlation_id }}",
        "ProcessId": 1234,
        "Image": "C:\\Windows\\System32\\curl.exe",
        "User": "{{ user }}",
        "Protocol": "tcp",
        "Initiated": "true",
        "SourceIp": "{{ src }}",
        "SourcePort": "{{ spt }}",
        "DestinationIp": "{{ dst }}",
        "DestinationPort": "{{ dpt }}"
      }
    }
  }
}
