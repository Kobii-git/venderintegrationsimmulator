      "DestinationIP": "{{ dst }}",
      "UserName": "{{ user }}",
      "EventFamily": "connection",
      "CorrelationId": "{{ correlation_id }}"
    },
    "native": "%ASA-6-302013: Built outbound TCP connection 1234 for outside:{{ dst }}/{{ dpt }} ({{ dst }}/{{ dpt }}) to inside:{{ src }}/{{ spt }} ({{ src }}/{{ spt }})"
