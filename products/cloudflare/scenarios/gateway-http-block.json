{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Cloudflare",
      "product": "Cloudflare",
      "version": "Logpush JSON",
      "family": "gateway-http-block",
      "name": "Gateway Http Block",
      "signature": "1006",
      "severity": 5,
      "default_format": "json",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": 49152,
      "dpt": 443,
      "action": "{{ action }}"
    },
    "record": {
      "Datetime": "{{ generated_at_iso }}",
      "HTTPHost": "{{ host }}",
      "HTTPMethod": "GET",
      "URL": "https://{{ host }}{{ uri }}",
      "SourceIP": "{{ src }}",
      "Action": "block",
      "PolicyName": "Lab HTTP policy"
    }
  }
}
