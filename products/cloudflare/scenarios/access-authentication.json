{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Cloudflare",
      "product": "Cloudflare",
      "version": "Logpush JSON",
      "family": "access-authentication",
      "name": "Access Authentication",
      "signature": "1004",
      "severity": 5,
      "default_format": "json",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": 49152,
      "dpt": 443,
      "action": "{{ action }}"
    },
    "record": {
      "CreatedAt": "{{ generated_at_iso }}",
      "Email": "{{ user }}@example.test",
      "IPAddress": "{{ src }}",
      "AppDomain": "{{ host }}",
      "Action": "login",
      "Allowed": true,
      "Connection": "onetimepin"
    }
  }
}
