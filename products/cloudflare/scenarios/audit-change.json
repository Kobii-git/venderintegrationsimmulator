{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Cloudflare",
      "product": "Cloudflare",
      "version": "Logpush JSON",
      "family": "audit-change",
      "name": "Audit Change",
      "signature": "1008",
      "severity": 5,
      "default_format": "json",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": 49152,
      "dpt": 443,
      "action": "{{ action }}"
    },
    "record": {
      "When": "{{ generated_at_iso }}",
      "ActionType": "update",
      "ActorEmail": "{{ user }}@example.test",
      "ActorIP": "{{ src }}",
      "ResourceType": "firewallrule",
      "ResourceID": "11111111-2222-4333-8444-555555555555",
      "ID": "{{ correlation_id }}"
    }
  }
}
