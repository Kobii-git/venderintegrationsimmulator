{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Cloudflare",
      "product": "Cloudflare",
      "version": "Logpush JSON",
      "family": "gateway-network-block",
      "name": "Gateway Network Block",
      "signature": "1007",
      "severity": 5,
      "default_format": "json",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": 49152,
      "dpt": 443,
      "action": "{{ action }}"
    },
    "record": {
      "Datetime": "{{ generated_at_iso }}",
      "SourceIP": "{{ src }}",
      "DestinationIP": "{{ dst }}",
      "DestinationPort": 443,
      "Protocol": "tcp",
      "Action": "block",
      "PolicyName": "Lab network policy"
    }
  }
}
