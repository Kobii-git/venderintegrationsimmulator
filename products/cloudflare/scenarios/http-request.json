{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Cloudflare",
      "product": "Cloudflare",
      "version": "Logpush JSON",
      "family": "http-request",
      "name": "Http Request",
      "signature": "1000",
      "severity": 5,
      "default_format": "json",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": 49152,
      "dpt": 443,
      "action": "{{ action }}"
    },
    "record": {
      "RayID": "{{ correlation_id }}",
      "ClientIP": "{{ src }}",
      "ClientRequestHost": "{{ host }}",
      "ClientRequestMethod": "GET",
      "ClientRequestURI": "{{ uri }}",
      "EdgeResponseStatus": 200,
      "EdgeStartTimestamp": "{{ generated_at_iso }}",
      "EdgeEndTimestamp": "{{ generated_at_iso }}",
      "CacheCacheStatus": "miss"
    }
  }
}
