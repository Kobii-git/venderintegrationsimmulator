{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Cloudflare",
      "product": "Cloudflare",
      "version": "Logpush JSON",
      "family": "dns-query",
      "name": "Dns Query",
      "signature": "1003",
      "severity": 5,
      "default_format": "json",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": 49152,
      "dpt": 443,
      "action": "{{ action }}"
    },
    "record": {
      "Timestamp": "{{ generated_at_iso }}",
      "QueryName": "{{ host }}",
      "QueryType": 1,
      "ResponseCode": 0,
      "SourceIP": "{{ src }}",
      "ColoCode": "JNB"
    }
  }
}
