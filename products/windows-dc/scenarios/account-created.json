{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Microsoft",
      "product": "Windows Security",
      "version": "Windows Server 2022 event schema",
      "family": "account-created",
      "name": "Account Created",
      "signature": "4720",
      "severity": 5,
      "default_format": "xml",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": "{{ spt }}",
      "dpt": "{{ dpt }}",
      "action": "allowed"
    },
    "record": {
      "TimeGenerated": "{{ generated_at_iso }}",
      "Computer": "{{ hostname }}",
      "EventID": 4720,
      "EventRecordId": "{{ event_sequence + 1 }}",
      "Channel": "Security",
      "Provider": "Microsoft-Windows-Security-Auditing",
      "EventData": {
        "TargetUserName": "{{ user }}",
        "TargetDomainName": "LAB",
        "TargetSid": "S-1-5-21-1000-1000-1000-1101",
        "SubjectUserName": "administrator",
        "SubjectDomainName": "LAB",
        "SamAccountName": "{{ user }}",
        "UserPrincipalName": "{{ user }}@lab.local",
        "NewUacValue": "0x10"
      }
    }
  }
}
