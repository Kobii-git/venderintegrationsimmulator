{
  "content_type": "application/json",
  "body": {
    "_source_event": {
      "vendor": "Microsoft",
      "product": "Windows Security",
      "version": "Windows Server 2022 event schema",
      "family": "kerberos-ticket",
      "name": "Kerberos Ticket",
      "signature": "4769",
      "severity": 5,
      "default_format": "xml",
      "time": "{{ generated_at_iso }}",
      "hostname": "{{ hostname }}",
      "device_ip": "{{ device_ip }}",
      "src": "{{ src }}",
      "dst": "{{ dst }}",
      "user": "{{ user }}",
      "spt": "{{ spt }}",
      "dpt": "{{ dpt }}",
      "action": "allowed"
    },
    "record": {
      "TimeGenerated": "{{ generated_at_iso }}",
      "Computer": "{{ hostname }}",
      "EventID": 4769,
      "EventRecordId": "{{ event_sequence + 1 }}",
      "Channel": "Security",
      "Provider": "Microsoft-Windows-Security-Auditing",
      "EventData": {
        "TargetUserName": "{{ user }}",
        "TargetDomainName": "LAB.LOCAL",
        "ServiceName": "cifs/server01",
        "ServiceSid": "S-1-5-21-1000-1000-1000-1102",
        "TicketOptions": "0x40810000",
        "TicketEncryptionType": "0x12",
        "IpAddress": "{{ src }}",
        "IpPort": "{{ spt }}",
        "Status": "0x0",
        "LogonGuid": "{{ correlation_id }}"
      }
    }
  }
}
