# Integration Simulator — environment configuration
# Copy to .env and adjust. Never commit real secrets.

# --- Core ---
APP_ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- Paths ---
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/integration_simulator.db
PRODUCTS_DIR=products
STATIC_DIR=frontend/dist

# --- Security ---
# Set a stable value in production so encrypted credentials survive restores/moves.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=
# If omitted, the container generates /data/.secret_key in the persistent volume.

# --- Optional protected remote-exposure profile ---
# Generate a hash with: docker run --rm caddy:2.10.2-alpine caddy hash-password
# Keep a bcrypt/argon2 hash single-quoted so '$' characters remain literal.
# REMOTE_USERNAME=collector
# REMOTE_PASSWORD_HASH='$2a$14$replace-with-generated-hash'

# --- API / UI ---
# Disable OpenAPI docs in production deployments (default false in Docker image)
ENABLE_OPENAPI_DOCS=true

# --- Scheduler limits ---
# SCHEDULER_MIN_INTERVAL_SECONDS=1
# SCHEDULER_MAX_INTERVAL_SECONDS=3600
# SCHEDULER_MAX_EVENT_COUNT=10000
# SCHEDULER_MAX_CONCURRENT_SIMULATIONS=10
# SCHEDULER_RESUME_ON_RESTART=false

# --- Event retention ---
# EVENT_RETENTION_DAYS=30
# EVENT_RETENTION_MAX_PER_SIMULATION=10000
# EVENT_RETENTION_CLEANUP_ON_STARTUP=true
# EVENT_RETENTION_CLEANUP_INTERVAL_SECONDS=3600

# --- Fault injection safety ---
# FAULT_MAX_BURST_COUNT=50
# FAULT_MAX_BURST_RATE_PER_SECOND=5.0
# FAULT_LARGE_RUN_CONFIRMATION_THRESHOLD=20

# --- SSRF awareness ---
# Log warnings when destinations target private/loopback addresses (allowed by default)
# SSRF_WARN_ON_PRIVATE_DESTINATIONS=true
